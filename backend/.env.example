MONGO_URL="mongodb://localhost:27017"
DB_NAME="careerniche_tracker"
CORS_ORIGINS="*"
JWT_SECRET="replace-with-a-long-random-string"
FRONTEND_URL="http://localhost:3000"
# true = new accounts must click the email link before using the app
REQUIRE_EMAIL_VERIFICATION="false"
# true = when email isn't configured, API returns verification/reset links so you can test
DEV_MODE="true"
# Optional: Resend (https://resend.com) for verification, reset and weekly report emails
RESEND_API_KEY=""
EMAIL_FROM="CareerNiche <onboarding@resend.dev>"
# Optional: secret for the daily scheduler that calls POST /api/reports/weekly/run
CRON_SECRET=""
